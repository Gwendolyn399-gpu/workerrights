# 后端配置示例。复制为 .env 后按需修改，不要提交真实密钥。
# 不设置 DATABASE_URL 时，默认使用项目根目录的 workerrights.db。
# DATABASE_URL=sqlite:///./workerrights.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_MODE=true
LOG_LEVEL=info
SERVICE_REGION=河南省
MAX_UPLOAD_MB=10

# 默认 mock：本地规则引擎（不是大模型）。
LLM_PROVIDER=mock

# 以下为预留的 OpenAI 兼容适配器配置。当前业务流程未调用云端润色；
# 启用前需补充用户授权、数据最小化和输出校验。密钥只放服务端。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30

# 前端开发服务器代理目标（读取于 next.config.mjs）。
BACKEND_URL=http://127.0.0.1:8000
