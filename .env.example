# 后端配置示例。复制为 .env 后按需修改，不要提交真实密钥。
# 不设置 DATABASE_URL 时，默认使用项目根目录的 workerrights.db。
# DATABASE_URL=sqlite:///./workerrights.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_MODE=true
LOG_LEVEL=info
SERVICE_REGION=河南省
MAX_UPLOAD_MB=10

# 默认 mock：本地规则引擎（不是大模型）。
LLM_PROVIDER=mock

# 真实 Agent：将上面的 LLM_PROVIDER 改为 openai_compatible，并填写下面的配置。
# 消息和案件上下文会发送至配置的模型服务。先使用虚构案例测试。密钥只放服务端。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30
AGENT_MAX_STEPS=6

# 前端开发服务器代理目标（读取于 next.config.mjs）。
BACKEND_URL=http://127.0.0.1:8000
